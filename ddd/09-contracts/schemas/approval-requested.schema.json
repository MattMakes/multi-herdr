{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ddd/09-contracts/schemas/approval-requested.schema.json",
  "title": "Approval Requested",
  "description": "A needs-you/ file: an idea waits for the operator's approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ideaId",
    "assumptionsHash"
  ],
  "properties": {
    "ideaId": {
      "type": "string",
      "pattern": "^I-[0-9]{4,}$",
      "description": "The idea in awaiting_approval."
    },
    "assumptionsHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "sha256 of the assumptions.md to approve; horch idea approve sends it back."
    }
  }
}
