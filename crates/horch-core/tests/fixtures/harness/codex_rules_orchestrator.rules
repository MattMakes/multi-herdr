prefix_rule(
    pattern = ["horch", "tell"],
    decision = "allow",
    justification = "herdr-fleet: message any worker in the fleet",
)
prefix_rule(
    pattern = ["horch", "inbox"],
    decision = "allow",
    justification = "herdr-fleet: list the live, reachable roles",
)
prefix_rule(
    pattern = ["horch", "sessions"],
    decision = "allow",
    justification = "herdr-fleet: read the project session ledger",
)
prefix_rule(
    pattern = ["horch", "layout"],
    decision = "allow",
    justification = "herdr-fleet: report the worker grid and the next split",
)
prefix_rule(
    pattern = ["horch", "quota"],
    decision = "allow",
    justification = "herdr-fleet: read the usage pools",
)
prefix_rule(
    pattern = ["horch", "route"],
    decision = "allow",
    justification = "herdr-fleet: see what the usage-limit gate decides for a persona",
)
prefix_rule(
    pattern = ["horch", "context"],
    decision = "allow",
    justification = "herdr-fleet: report the context size of every session",
)
prefix_rule(
    pattern = ["horch", "compact"],
    decision = "allow",
    justification = "herdr-fleet: compact a session at a stopping point",
)
prefix_rule(
    pattern = ["horch", "mode"],
    decision = "allow",
    justification = "herdr-fleet: switch a read-only Codex worker to write and back",
)
prefix_rule(
    pattern = ["horch", "ledger"],
    decision = "allow",
    justification = "herdr-fleet: read the task ledger, and stop, fall back or waive for the operator",
)
prefix_rule(
    pattern = ["horch", "ideas"],
    decision = "allow",
    justification = "herdr-fleet: read each idea and the needs-you list",
)
prefix_rule(
    pattern = ["horch", "idea"],
    decision = "allow",
    justification = "herdr-fleet: show an idea, or add, amend, revise, park or cancel one for the operator",
)
prefix_rule(
    pattern = ["horch", "task"],
    decision = "allow",
    justification = "herdr-fleet: requeue or cancel a task for the operator",
)
prefix_rule(
    pattern = ["horch", "feature"],
    decision = "allow",
    justification = "herdr-fleet: abandon a feature for the operator",
)
