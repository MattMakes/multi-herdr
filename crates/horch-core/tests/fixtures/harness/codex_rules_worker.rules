prefix_rule(
    pattern = ["horch", "tell"],
    decision = "allow",
    justification = "herdr-fleet: report to the orchestrator or message another fleet worker",
)
prefix_rule(
    pattern = ["horch", "note"],
    decision = "allow",
    justification = "herdr-fleet: record progress in the session ledger",
)
prefix_rule(
    pattern = ["horch", "skills", "read"],
    decision = "allow",
    justification = "herdr-fleet: read a catalog skill that the bundle does not hold",
)
prefix_rule(
    pattern = ["horch", "done"],
    decision = "allow",
    justification = "herdr-fleet: mark session done and close own pane",
)
prefix_rule(
    pattern = ["horch", "ledger", "add"],
    decision = "forbidden",
    justification = "herdr-fleet: a worker never queues a task, and its check command would run unsandboxed",
)
prefix_rule(
    pattern = ["horch", "ledger", "add-map"],
    decision = "forbidden",
    justification = "herdr-fleet: a worker never queues tasks, and their check commands would run unsandboxed",
)
prefix_rule(
    pattern = ["horch", "ledger", "reopen"],
    decision = "forbidden",
    justification = "herdr-fleet: a worker never reopens a task, and its check command would run unsandboxed",
)
prefix_rule(
    pattern = ["git", "worktree", "add"],
    decision = "forbidden",
    justification = "herdr-fleet: only fleetd makes a worktree; use horch ledger worktree new",
)
prefix_rule(
    pattern = ["git", "worktree", "remove"],
    decision = "forbidden",
    justification = "herdr-fleet: only fleetd removes a worktree; horch ledger finish and drop remove it",
)
prefix_rule(
    pattern = ["git", "worktree", "prune"],
    decision = "forbidden",
    justification = "herdr-fleet: only fleetd prunes worktree records",
)
prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "herdr-fleet: fleet agents do not push; fleetd pushes the feature branch",
)
prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "forbidden",
    justification = "herdr-fleet: fleet agents do not merge a pull request",
)
prefix_rule(
    pattern = ["gh", "release"],
    decision = "forbidden",
    justification = "herdr-fleet: fleet agents do not make a release",
)
