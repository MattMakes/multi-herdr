prefix_rule(
    pattern = ["horch", "tell"],
    decision = "allow",
    justification = "herdr-fleet: report to the orchestrator or message another fleet worker",
)
prefix_rule(
    pattern = ["horch", "note"],
    decision = "allow",
    justification = "herdr-fleet: record progress in the session ledger",
)
prefix_rule(
    pattern = ["horch", "skills", "read"],
    decision = "allow",
    justification = "herdr-fleet: read a catalog skill that the bundle does not hold",
)
prefix_rule(
    pattern = ["horch", "done"],
    decision = "allow",
    justification = "herdr-fleet: mark session done and close own pane",
)
prefix_rule(
    pattern = ["horch", "ledger"],
    decision = "allow",
    justification = "herdr-fleet: claim, report and finish tasks through the task ledger",
)
prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "herdr-fleet: stage changes in own worktree",
)
prefix_rule(
    pattern = ["git", "commit"],
    decision = "allow",
    justification = "herdr-fleet: commit own work in own worktree",
)
