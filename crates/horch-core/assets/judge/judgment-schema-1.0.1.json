{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-herdr.local/schemas/judgment-1.0.1.json",
  "title": "Judgment",
  "description": "The judge answers with exactly one JSON object of this shape and nothing else.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verdict", "ranking", "candidates", "confidence", "rationale"],
  "properties": {
    "schema_version": { "const": "1.0.1" },
    "verdict": { "enum": ["winner", "tie", "abstain", "reject_all"] },
    "winner": {
      "description": "A candidate label. Required when verdict is winner; null or absent otherwise.",
      "type": ["string", "null"]
    },
    "ranking": {
      "description": "Every candidate label exactly once, best first.",
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "candidates": {
      "description": "One assessment per candidate label.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/assessment" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "rationale": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "verdict": { "const": "winner" } } },
      "then": { "required": ["winner"], "properties": { "winner": { "type": "string" } } },
      "else": { "properties": { "winner": { "type": "null" } } }
    }
  ],
  "$defs": {
    "score": { "type": "number", "minimum": 0, "maximum": 10 },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scores", "acceptable", "notes"],
      "properties": {
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["correctness", "tests", "scope", "maintainability", "risk"],
          "properties": {
            "correctness": { "$ref": "#/$defs/score" },
            "tests": { "$ref": "#/$defs/score" },
            "scope": { "$ref": "#/$defs/score" },
            "maintainability": { "$ref": "#/$defs/score" },
            "risk": { "$ref": "#/$defs/score" }
          }
        },
        "acceptable": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    }
  }
}
