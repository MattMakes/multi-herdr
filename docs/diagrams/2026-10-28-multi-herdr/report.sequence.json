{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "A worker report: relay first, typing as the fallback",
    "locale": "en",
    "viewBox": [
      1240,
      620
    ],
    "column_fit": "spread",
    "quality_profile": "showcase",
    "visual_preset": "signal-flow",
    "animation": "trace",
    "views": [
      {
        "id": "durable",
        "label": "1. Write it down first",
        "focus": [
          "agent",
          "tell",
          "mail"
        ],
        "note": "horch done writes the report to pending mail before it tries to deliver it."
      },
      {
        "id": "push",
        "label": "2. Push it",
        "focus": [
          "tell",
          "relay",
          "herdr",
          "orch"
        ],
        "note": "The channel relay is tried first. If it does not take the line, horch types it into the orchestrator pane."
      },
      {
        "id": "retry",
        "label": "3. Retry until acknowledged",
        "focus": [
          "tell",
          "courier",
          "orch",
          "mail"
        ],
        "note": "The courier redelivers until horch inbox acknowledges the report."
      }
    ]
  },
  "participants": [
    {
      "id": "agent",
      "type": "external",
      "label": "Worker agent"
    },
    {
      "id": "tell",
      "type": "backend",
      "label": "horch done"
    },
    {
      "id": "mail",
      "type": "database",
      "label": "Durable mail"
    },
    {
      "id": "relay",
      "type": "messagebus",
      "label": "Channel relay"
    },
    {
      "id": "herdr",
      "type": "cloud",
      "label": "Pane input"
    },
    {
      "id": "courier",
      "type": "backend",
      "label": "Courier"
    },
    {
      "id": "orch",
      "type": "frontend",
      "label": "Orchestrator"
    }
  ],
  "messages": [
    {
      "id": "done",
