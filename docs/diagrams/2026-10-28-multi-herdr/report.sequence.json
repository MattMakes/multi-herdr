      "label": "redelivery n"
    },
    {
      "id": "ack",
      "from": "orch",
      "to": "mail",
      "y": 530,
      "label": "horch inbox: ack",
      "variant": "return"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Order matters",
      "items": [
        "Mail first, so a failed push loses nothing",
        "The relay is tried first; typing is the fallback"
      ]
    },
    {
      "dot": "rose",
      "title": "Retry schedule",
      "items": [
        "Waits 30 s, 1, 2, 4, then 5 min",
