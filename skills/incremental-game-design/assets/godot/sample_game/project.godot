; Engine configuration file.
; Lamp Road: the sample game of the tuning bench.

config_version=5

[application]

config/name="Lamp Road"
run/main_scene="res://view/main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Session="*res://session/game_session.gd"
TuningBench="*res://addons/tuning_bench/bench.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
