{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Implementation or review report",
  "description": "Written by the writer (K/report.json) or the reviewer (K/review.json).",
  "type": "object",
  "required": [
    "role",
    "status",
    "spec_ids",
    "changed_files",
    "verification"
  ],
  "additionalProperties": false,
  "properties": {
    "role": {
      "enum": [
        "writer",
        "reviewer"
      ]
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "blocked"
      ]
    },
    "spec_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "argv",
          "exit_code"
        ],
        "additionalProperties": false,
        "properties": {
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exit_code": {
            "type": "integer"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "result"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "not-run"
            ]
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Abstract questions back to the controller. Never ask for source."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
