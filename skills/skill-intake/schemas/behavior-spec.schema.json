{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Behavioral specification",
  "description": "Written by the analyst, approved by the sanitizer. `provenance` and `review` are stripped at handoff. `skill.name` and public contract names may cross the wall.",
  "type": "object",
  "required": [
    "spec_id",
    "title",
    "summary",
    "skill",
    "behaviors",
    "test_scenarios"
  ],
  "additionalProperties": false,
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "properties": {
    "spec_id": {
      "type": "string",
      "pattern": "^spec-[a-z0-9-]{2,40}$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "summary": {
      "$ref": "#/$defs/text"
    },
    "skill": {
      "type": "object",
      "required": [
        "name",
        "purpose",
        "triggers",
        "outputs"
      ],
      "additionalProperties": false,
      "description": "The skill this spec describes. `name` is a public-contract name.",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "purpose": {
          "$ref": "#/$defs/text"
        },
        "triggers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "description": "Declared access the rewritten skill legitimately needs (spec 7.4).",
      "properties": {
        "network": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "reads": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "writes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "replace_or_remove": {
      "type": "array",
      "description": "1 entry per SUP and OPQ item of mitigation.json. `replace` is own stdlib-only code; `remove` is explicit in the skill text.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "finding",
          "action",
          "behavior"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R-[0-9]{1,4}$"
          },
          "finding": {
            "type": "string",
            "pattern": "^(SUP|OPQ)-[0-9]{2}#[0-9]{1,6}$"
          },
          "action": {
            "enum": [
              "replace",
              "remove"
            ]
          },
          "behavior": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "public_contract": {
      "type": "array",
      "description": "Names that must match exactly for compatibility. Only these may reuse source identifiers.",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "name",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "function",
              "type",
              "endpoint",
              "cli-flag",
              "config-key",
              "file-format",
              "event",
              "error-code",
              "constant"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "behaviors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "given",
          "when",
          "then"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^b[0-9]{1,4}$"
          },
          "given": {
            "$ref": "#/$defs/text"
          },
          "when": {
            "$ref": "#/$defs/text"
          },
          "then": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "test_scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "expected"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^t[0-9]{1,4}$"
          },
          "description": {
            "$ref": "#/$defs/text"
          },
          "input": {
            "$ref": "#/$defs/text"
          },
          "expected": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "unit_id"
      ],
      "additionalProperties": false,
      "properties": {
        "unit_id": {
          "type": "string"
        },
        "batch_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "reviewer",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "reviewer": {
          "const": "sanitizer"
        },
        "status": {
          "enum": [
            "approved",
            "rejected"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
