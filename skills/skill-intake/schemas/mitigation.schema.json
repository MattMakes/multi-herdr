{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mitigation plan",
  "description": "Contaminated side (C/mitigation.json). Written by `intake triage`; `spec_item` is filled by the analyst (spec 5).",
  "type": "object",
  "required": [
    "entries"
  ],
  "$defs": {
    "untrusted": {
      "type": "object",
      "required": [
        "untrusted"
      ],
      "additionalProperties": false,
      "properties": {
        "untrusted": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  },
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding",
          "severity",
          "skill",
          "disposition",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "finding": {
            "type": "string",
            "pattern": "^(INJ|SCR|SUP|OPQ|ACQ|AUD)-[0-9A-Z-]{2,12}#[0-9]{1,6}$"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "skill": {
            "type": [
              "string",
              "null"
            ]
          },
          "disposition": {
            "enum": [
              "rewrite",
              "remove",
              "replace",
              "removed"
            ]
          },
          "spec_item": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z][A-Za-z0-9-]{0,40}$"
          },
          "note": {
            "$ref": "#/$defs/untrusted"
          },
          "status": {
            "enum": [
              "planned",
              "mitigated-by-rewrite",
              "removed",
              "unresolved"
            ]
          }
        }
      }
    }
  }
}
