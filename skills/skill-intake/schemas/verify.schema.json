{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verify result",
  "description": "Contaminated side (C/verify.json). Written by `intake verify` for GATE 2 (spec 7.1).",
  "type": "object",
  "required": [
    "task_id",
    "target",
    "gate",
    "findings",
    "checks"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[0-9]{8}-[0-9]{6}-[0-9a-f]{6}$"
    },
    "target": {
      "enum": [
        "repo",
        "standalone"
      ]
    },
    "gate": {
      "enum": [
        "pass",
        "abort"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding",
          "status"
        ],
        "properties": {
          "finding": {
            "type": "string",
            "pattern": "^(INJ|SCR|SUP|OPQ|ACQ|AUD)-[0-9A-Z-]{2,12}#[0-9]{1,6}$"
          },
          "status": {
            "enum": [
              "mitigated-by-rewrite",
              "removed",
              "unresolved"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check",
          "result"
        ],
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "unverified",
              "inactive"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "scripts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "status"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "unverified"
            ]
          }
        }
      }
    }
  }
}
